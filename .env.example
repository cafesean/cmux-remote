# Copy to .env and fill in. .env is gitignored — real URLs/secrets never get committed.
# (Node 20.6+ can also load this with `node --env-file=.env server.js`.)
#
# TWO trust layers — that's why there are two secrets:
#   browser → server : SERVER_TOKEN            (who may open the web UI)
#   server  → bridge : BRIDGE_SECRET (on the Mac) MUST EQUAL CMUX_MACHINE_SECRET (here on the server)
# Pick each secret once with e.g.  openssl rand -hex 16

# ── bridge.js — run on each Mac where cmux is installed ──────────────────────
# 8799 default (8790 is a common default for other cmux bridges — avoid the clash).
BRIDGE_PORT=8799
# Long random string. The server must present this. Empty = no auth (trusted LAN only).
BRIDGE_SECRET=change-me-to-a-long-random-string
# CMUX_BIN=/Applications/cmux.app/Contents/Resources/bin/cmux

# ── server.js — the UI + proxy; run once, somewhere you trust ────────────────
PORT=8080
# Token the browser must present to use the UI. Empty = open (trusted LAN only).
SERVER_TOKEN=change-me-to-a-long-random-string

# ── machine registry (server.js) ────────────────────────────────────────────
# Simplest: one default machine via env. baseUrl = however you reach that bridge
# (LAN ip, or your own tunnel URL — see README). SECRET must match that bridge's BRIDGE_SECRET.
CMUX_MACHINE_LABEL=My Mac
CMUX_MACHINE_URL=http://192.0.2.1:8799
CMUX_MACHINE_SECRET=must-match-that-bridge-BRIDGE_SECRET

# Optional — Cloudflare Access service token, if the bridge is behind a named tunnel gated by CF Access:
# CMUX_MACHINE_ACCESS_ID=
# CMUX_MACHINE_ACCESS_SECRET=

# Multiple machines — a JSON array (extends/overrides the single default above):
# CMUX_MACHINES=[{"id":"laptop","label":"Laptop","baseUrl":"https://laptop.example.com","secret":"..."}]

# Or keep the registry in a gitignored JSON file instead:
# CMUX_CONFIG=./config.json

# ── filesystem browse (bridge.js) ──────────────────────────────────────────
# Which directories the Files tab may read. Colon-separated absolute paths, and/or the literal
# `workspace-cwds`, which resolves to whatever directories cmux currently has open. A malformed
# or empty value falls back to workspace-cwds.
#
# WARNING: FS_ROOTS=/ makes the ENTIRE DISK readable by anyone holding SERVER_TOKEN, over
# whatever tunnel the server is exposed on — SSH keys, cloud credentials, browser cookie stores,
# and BRIDGE_SECRET itself. Only set this on a machine you alone use, with a long SERVER_TOKEN
# and an identity gate (e.g. Cloudflare Access) in front of the tunnel.
FS_ROOTS=workspace-cwds
# Max bytes read from a single file; larger files are shown truncated.
FS_READ_MAX=1048576
# Hard ceiling on the per-page entry count the client may request.
FS_PAGE_MAX=500

# ── radar (server.js) ──────────────────────────────────────────────────────
# OFF by default, and off means the module is never loaded: with RADAR_ENABLED unset, nothing
# under radar/ is required, no timer is installed, and every /api/radar/* path 404s. Set it to 1
# to mount the collector and its routes. Rollback = remove this line and restart.
# RADAR_ENABLED=1
# Radar's own directory (config.json, state.json, aliases.json, decisions.json). It writes here
# and NOWHERE else — never to git, Jira, a database, or a deploy. Defaults to ~/.radar; give an
# ABSOLUTE path if you override it — nothing expands a leading ~ in a .env file.
# RADAR_DIR=/Users/you/.radar
# ── dropped files (bridge.js) ──────────────────────────────────────────────
# Where a file dragged/pasted/picked in the remote UI is written on the Mac. The client then types
# the resulting absolute path into the terminal, which is what dragging an image into a terminal
# does locally. Files land in a per-day subfolder and are never overwritten (name-1, name-2, …).
#
# The name is reduced to a basename with control characters and shell-syntax stripped, so a caller
# cannot escape this directory — but everything under it IS writable by anyone holding
# SERVER_TOKEN. Keep it a scratch directory, not a source tree or anything on PATH.
# UPLOAD_DIR=~/Downloads/cmux-remote
# Hard cap per file (bytes). Enforced by the server before the tunnel and by the bridge again.
# UPLOAD_MAX_BYTES=33554432

# ---- p7: compose-box completions -------------------------------------------
# On by default (cheap, read-only). Set to 0 to drop the endpoint entirely.
COMPLETIONS_ENABLED=1

# ---- p7: source control ------------------------------------------------------
# OFF by default. Reads and writes have SEPARATE switches on purpose: turning the
# panel on is a browsing decision, while direct index writes add execution that
# leaves nothing in any terminal's scrollback. Destructive verbs are never
# directly invocable at all — the panel generates command TEXT and fills a pane's
# composer with it, unsent.
GIT_PANEL_ENABLED=
GIT_WRITES_ENABLED=

# ---- p7: live-menu mirroring, shell side ------------------------------------
# For zsh completion menus to be mirrored as tappable chips, the shell needs an
# INTERACTIVE completion menu. `zstyle menu select` alone does nothing — the
# module has to be loaded first:
#   zmodload zsh/complist
#   zstyle ':completion:*' menu select
# Even then zsh lays candidates out in COLUMNS whenever they fit, and multi-column
# menus render no chips (up/down cannot reach sideways, and a tapped row is
# ambiguous). Claude Code's own / and @ menus are single-column and work.
