{
  "name": "cmux-remote",
  "version": "0.1.0",
  "description": "View and drive your local cmux terminal and browser tabs from any browser or phone. Self-hostable, multi-machine, zero-dependency.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "cmux-remote-bridge": "bridge.js",
    "cmux-remote-server": "server.js",
    "radar": "radar/radar-cli.js"
  },
  "scripts": {
    "bridge": "node bridge.js",
    "server": "node server.js",
    "radar": "node radar/radar-cli.js",
    "test": "node --test test/*.test.js",
    "test:eval:inbox": "node scripts/eval-inbox.mjs",
    "test:browser:inbox": "node scripts/browser-inbox.mjs"
  },
  "keywords": [
    "cmux",
    "terminal",
    "agents",
    "remote"
  ]
}
