{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmux-remote/radar/state.v1.schema.json",
  "title": "radar state.json v1",
  "description": "The versioned snapshot contract. Consumers (radar CLI, /api/radar/state, the Radar tab, external brief consumers) read ONLY this shape. Additive changes keep v:1; any removal or retype bumps v.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "generatedAt", "collectorId", "machines", "sources", "counts", "repos", "epics", "sessions", "attention", "handoffs", "handoffRecovery", "role"],
  "properties": {
    "v": { "const": 1 },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "collectorId": { "type": "string", "minLength": 1 },
    "machines": { "type": "array", "items": { "$ref": "#/$defs/machine" } },
    "sources": {
      "type": "object",
      "description": "Metadata is ALWAYS fresh, even when the data fragment was carried forward from the last good scan (spec §3).",
      "required": ["git", "sessions", "deploy", "jira", "specs", "config"],
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocked", "decisions", "mergeable", "orphans", "staleWorktrees", "handoffsLive"],
      "properties": {
        "blocked": { "type": "integer", "minimum": 0 },
        "decisions": { "type": "integer", "minimum": 0 },
        "mergeable": { "type": "integer", "minimum": 0 },
        "orphans": { "type": "integer", "minimum": 0 },
        "staleWorktrees": { "type": "integer", "minimum": 0 },
        "handoffsLive": { "type": "integer", "minimum": 0, "description": "p6: handoffs.length — the ONE count p6 adds. Every p5 count is computed BEFORE suppression (spec §6.6)." },
        "inbox": { "type": "integer", "minimum": 0, "description": "p9 (spec §5.4): inbox.length — from the LIST, never from a display array. Present in properties but NOT in required, so snapshots predating p9 (the committed fixtures among them) stay valid." },
        "workRefs": { "type": "integer", "minimum": 0, "description": "p11: OPTIONAL — absent from `required` so a pre-p11 snapshot still validates. Counted from the source list, never from a folded view." },
        "workRefsSelectable": { "type": "integer", "minimum": 0, "description": "p11: OPTIONAL. How many WorkRefs a session could act on right now (spec §6.2)." }
      }
    },
    "repos": { "type": "object", "additionalProperties": { "$ref": "#/$defs/repo" } },
    "epics": { "type": "array", "items": { "$ref": "#/$defs/epic" } },
    "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } },
    "attention": { "type": "array", "items": { "$ref": "#/$defs/attention" } },
    "inbox": {
      "type": "array",
      "description": "p9 (spec §5.3/§5.4): every session actually waiting on the operator, oldest-first, uncapped and ungrouped. The ONE derivation that reads the full sessions[] — a vanished session keeps its row (read-only) while every other derivation is shielded from it. Root is closed, so the key must be declared here; it is NOT in root.required, so pre-p9 snapshots stay valid.",
      "items": { "$ref": "#/$defs/inboxItem" }
    },
    "handoffs": {
      "type": "array",
      "description": "p6 (spec §4.6): ONLY handoffs that hold fact keys — the live set. Terminal handoffs are absent entirely; they live in the ledger. Consumed by the derivation for suppression, never rendered.",
      "items": { "$ref": "#/$defs/handoff" }
    },
    "handoffRecovery": {
      "type": ["object", "null"],
      "description": "p6 (spec §M4): ONE object for the WHOLE undecidable set, or null. No ids, no count, no array — REQUIRED so a consumer's `!== null` predicate can never fire on an omitted key (undefined !== null).",
      "additionalProperties": false,
      "required": ["token", "since"],
      "properties": {
        "token": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "since": { "type": "string" }
      }
    },
    "role": {
      "enum": ["leader", "viewer"],
      "description": "p6 (spec §3): published from config.role by derive(); a viewer's OWN proxy overwrites it to \"viewer\" on the response — the only field the proxy rewrites. The tab renders no select affordance when it reads viewer."
    },
    "jiraDrift": {
      "type": "array",
      "description": "Weekly digest material (spec §M4). NEVER an interrupt and never an attention item — a Jira status that git cannot corroborate belongs here, not on the board.",
      "items": { "$ref": "#/$defs/jiraDriftItem" }
    },
    "workRefs": {
      "type": "array",
      "description": "p11 (spec §4.1): canonical, source-neutral work references. ADDITIVE and OPTIONAL — absent from `required` on purpose, so a snapshot taken before p11 still validates. status.native/nativeCategory are the source's authority; status.canonical is radar's projection and is never written back. A consumer that assumes this key is present is the defect, not the snapshot that omits it.",
      "items": { "$ref": "#/$defs/workRef" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "selectors", "factKeys", "session"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["pending", "launching", "active", "quiet", "unconfirmed"],
          "description": "The LIVE statuses only (spec §4.1.1). resolved/abandoned/discarded never appear here — a terminal handoff is absent from state.json."
        },
        "selectors": { "type": "array", "items": { "type": "string" } },
        "factKeys": { "type": "array", "items": { "type": "string" }, "description": "The one suppression identity (spec §6.6)." },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["machine", "sessionId"],
          "properties": { "machine": { "type": "string" }, "sessionId": { "type": "string" } }
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bridge", "lastSeenAt"],
      "properties": {
        "id": { "type": "string" },
        "bridge": { "enum": ["ok", "offline", "unknown"] },
        "lastSeenAt": { "$ref": "#/$defs/nullableString" },
        "eventsStatus": {
          "enum": ["ok", "offline", "unknown"],
          "description": "S-004: hook-event availability, INDEPENDENT of the bridge. The leader reads its own events off disk, so its bridge can be down while its events are current."
        },
        "stale": {
          "type": "boolean",
          "description": "S-004: this machine's session facts are carried forward from the last good sweep, not re-observed."
        },
        "statusTruncated": {
          "type": "boolean",
          "description": "S-004a: the bridge's 60-tab list-status cap bit. Tabs past it carry status `unknown` and are still listed — a missing status is never a green."
        },
        "error": { "$ref": "#/$defs/nullableString" }
      }
    },
    "workRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["urn", "source", "sourceId", "status", "cluster"],
      "properties": {
        "urn": { "type": "string", "description": "urn:work:<source>:<sourceId> — stable across scans by construction." },
        "source": { "type": "string" },
        "sourceId": { "type": "string" },
        "sourceUrl": { "type": ["string", "null"] },
        "kind": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "status": {
          "type": "object",
          "required": ["canonical"],
          "properties": {
            "native": { "type": ["string", "null"], "description": "The source's own word, verbatim. This is the authority." },
            "nativeCategory": { "enum": ["new", "indeterminate", "done", null] },
            "canonical": { "enum": ["inbox", "ready", "active", "blocked", "waiting", "parked", "done", "unknown"] }
          }
        },
        "cluster": { "type": ["string", "null"] },
        "links": { "type": "array", "items": { "type": "string" } },
        "selectable": { "type": "boolean" },
        "route": { "type": ["object", "null"], "description": "Resolved once per scan (spec §6.3) so every consumer reads one answer. Null means unresolved, and the reason travels with it." }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["ok", "stale", "error", "disabled"] },
        "observedAt": { "type": "string" },
        "error": { "type": "string" },
        "boards": { "type": "integer", "minimum": 0, "description": "p11: OPTIONAL per-source counter (jiraAgile). Descriptive; no consumer branches on it." },
        "pending": { "type": "integer", "minimum": 0, "description": "p11: OPTIONAL. Work observed but not intaken because a bound was hit — reported so truncation is never silent." }
      }
    },
    "dirty": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["staged", "unstaged", "untracked"],
      "properties": {
        "staged": { "type": "integer", "minimum": 0 },
        "unstaged": { "type": "integer", "minimum": 0 },
        "untracked": { "type": "integer", "minimum": 0 }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha", "epic", "epicVia", "isDefault", "unpushed", "noRemote", "mergedIntoDevelop", "mergedIntoMain", "lastCommitAt", "worktree"],
      "properties": {
        "name": { "type": "string" },
        "sha": { "type": "string" },
        "epic": { "$ref": "#/$defs/nullableString" },
        "epicVia": { "enum": ["issue-key", "alias", "override", "orphan"] },
        "isDefault": { "type": "boolean" },
        "unpushed": { "type": ["integer", "null"], "minimum": 0, "description": "rev-list --count <branch> --not --remotes. null = the count could not be taken (unknown, never 0)." },
        "noRemote": { "type": "boolean", "description": "true = the branch has no configured upstream. Does NOT change the unpushed algorithm." },
        "mergedIntoDevelop": { "type": ["boolean", "null"] },
        "mergedIntoMain": { "type": ["boolean", "null"] },
        "lastCommitAt": { "$ref": "#/$defs/nullableString" },
        "worktree": { "$ref": "#/$defs/nullableString" }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch", "head", "isMain", "bare", "locked", "prunable", "dirty", "dirtyError", "stale", "staleReason", "cleanupCommand"],
      "properties": {
        "path": { "type": "string" },
        "branch": { "$ref": "#/$defs/nullableString", "description": "null for a detached HEAD worktree." },
        "head": { "$ref": "#/$defs/nullableString" },
        "isMain": { "type": "boolean" },
        "bare": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "prunable": { "type": "boolean" },
        "dirty": { "$ref": "#/$defs/dirty" },
        "dirtyError": { "$ref": "#/$defs/nullableString" },
        "stale": { "type": "boolean" },
        "staleReason": { "type": ["string", "null"], "enum": ["merged", "epic-closed", "idle-30d", null] },
        "cleanupCommand": { "$ref": "#/$defs/nullableString", "description": "A command STRING for a human to run. Radar never executes it and never removes a branch." }
      }
    },
    "deployEnv": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["ok", "empty", "unauthorized", "stale", "unknown"], "description": "empty NEVER renders as in-sync." },
        "sha": { "$ref": "#/$defs/nullableString" },
        "ruleViolation": { "type": ["boolean", "null"] },
        "probedAt": { "$ref": "#/$defs/nullableString" }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "defaultBranches", "branches", "worktrees", "deploy", "fetch"],
      "properties": {
        "path": { "type": "string" },
        "defaultBranches": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nullableString" } },
        "branches": { "type": "array", "items": { "$ref": "#/$defs/branch" } },
        "worktrees": { "type": "array", "items": { "$ref": "#/$defs/worktree" } },
        "deploy": {
          "type": ["object", "null"],
          "properties": { "dev": { "$ref": "#/$defs/deployEnv" }, "prod": { "$ref": "#/$defs/deployEnv" } }
        },
        "fetch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "error"],
          "properties": { "status": { "enum": ["ok", "stale", "skipped"] }, "error": { "$ref": "#/$defs/nullableString" } }
        }
      }
    },
    "ladderCell": { "enum": ["done", "current", "todo", "unknown", "violation"] },
    "epic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "aliases", "title", "jira", "ladder", "zone", "signals", "phrase", "lastActivityAt", "repos", "flag", "branchCount"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "title": { "$ref": "#/$defs/nullableString" },
        "jira": { "type": ["object", "null"] },
        "ladder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spec", "pushed", "mergedDevelop", "deployedDev", "prod", "flags"],
          "properties": {
            "spec": { "$ref": "#/$defs/ladderCell" },
            "pushed": { "$ref": "#/$defs/ladderCell", "description": "Named `pushed`, never `built`: the cell may only claim what git proves." },
            "mergedDevelop": { "$ref": "#/$defs/ladderCell" },
            "deployedDev": { "$ref": "#/$defs/ladderCell" },
            "prod": { "$ref": "#/$defs/ladderCell" },
            "flags": { "$ref": "#/$defs/ladderCell" }
          }
        },
        "zone": { "enum": ["active", "dormant"], "description": "gone epics are absent from epics[] entirely." },
        "signals": {
          "type": "array",
          "items": { "enum": ["session-blocked", "session-live", "decision-open", "jira-in-progress", "recent-commit", "unpushed-commits", "dirty-worktree", "unmerged-develop", "merged-not-deployed", "deployed-flag-off"] }
        },
        "phrase": { "type": "string" },
        "lastActivityAt": { "type": "string" },
        "repos": { "type": "array", "items": { "type": "string" } },
        "flag": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["state", "assertedAt", "stale"],
          "properties": {
            "state": { "enum": ["on", "off", "n/a"] },
            "assertedAt": { "$ref": "#/$defs/nullableString" },
            "stale": { "type": "boolean" }
          }
        },
        "branchCount": { "type": "integer", "minimum": 0 }
      }
    },
    "session": {
      "type": "object",
      "required": ["key", "status"],
      "properties": {
        "key": {
          "type": "object",
          "required": ["machine", "sessionId"],
          "properties": { "machine": { "type": "string" }, "sessionId": { "type": "string" } }
        },
        "status": { "enum": ["running", "idle", "blocked"], "description": "idle = live, never finished." },
        "epic": { "$ref": "#/$defs/nullableString" },
        "repo": { "$ref": "#/$defs/nullableString" },
        "surface": { "type": ["object", "null"] },
        "notificationType": { "$ref": "#/$defs/nullableString" },
        "cacheExpiresAt": { "$ref": "#/$defs/nullableString" },
        "cacheApprox": { "type": "boolean" },
        "surfaceReason": {
          "$ref": "#/$defs/nullableString",
          "description": "Why the surface join produced null, from a fixed vocabulary (no-cwd, shared-cwd, no-workspace-for-cwd, ambiguous-workspace, no-terminal-tab, ambiguous-tabs:<n>, no-tab-uuid, tree-unavailable, recorded-tab-gone). Null when a surface WAS resolved — including the exact case, where the session recorded its own cmux surface id and the tree confirmed it."
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "enum": ["jump", "context", "close", "tag", "runbook", "expand"] } }
    },
    "inboxItem": {
      "type": "object",
      "description": "p9 (spec §5.3). Closed: the row contract is exact, and a field that leaked in from the source session — `tabStatus` above all — would invite a consumer to read workspace-scoped provenance as per-tab readiness.",
      "additionalProperties": false,
      "required": ["sessionKey", "blockedSince", "lastStopAt", "cacheExpiresAt", "cacheApprox", "notificationType", "turn", "repo", "worktree", "epic", "question", "title", "titleSource", "intent", "surface", "surfaceReason", "answerable", "actions"],
      "properties": {
        "sessionKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["machine", "sessionId"],
          "properties": { "machine": { "type": "string" }, "sessionId": { "type": "string" } }
        },
        "blockedSince": { "type": "string" },
        "lastStopAt": { "$ref": "#/$defs/nullableString" },
        "cacheExpiresAt": { "$ref": "#/$defs/nullableString" },
        "cacheApprox": { "const": true, "description": "Always approximate: the prompt-cache TTL drops to 5 min under overage and radar cannot see which regime it is in." },
        "notificationType": { "type": "string" },
        "turn": {
          "type": "object",
          "description": "The turn identity token a reply must echo (spec §5.5). blockedSince is the row's own value verbatim.",
          "additionalProperties": false,
          "required": ["blockedSince", "assistantTs"],
          "properties": { "blockedSince": { "type": "string" }, "assistantTs": { "$ref": "#/$defs/nullableString" } }
        },
        "repo": { "$ref": "#/$defs/nullableString" },
        "worktree": { "$ref": "#/$defs/nullableString" },
        "epic": { "$ref": "#/$defs/nullableString" },
        "question": { "type": "string", "description": "The COMPLETE last assistant text, never truncated here; '' when there is none. Truncation is a rendering concern." },
        "title": { "$ref": "#/$defs/nullableString", "description": "The session topic — an operator rename or the automatic titler, COMPLETE and untruncated; null when the transcript tail carried neither." },
        "titleSource": { "type": ["string", "null"], "enum": ["custom", "ai", null], "description": "Provenance of title: custom = explicit rename (authoritative, wins over a later ai-title), ai = automatic titler. null iff title is null." },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "reason", "model", "at", "inferred"],
          "properties": {
            "verdict": { "enum": ["needs-decision", "unknown"], "description": "Only the two verdicts that reach the queue; offer-more and status-only are filtered out by buildInbox." },
            "reason": { "$ref": "#/$defs/nullableString" },
            "model": { "$ref": "#/$defs/nullableString", "description": "null on every unknown path." },
            "at": { "type": "string" },
            "inferred": { "const": true }
          }
        },
        "surface": {
          "type": ["object", "null"],
          "description": "EXACTLY four fields. tabStatus and every other source-surface field are not projected.",
          "additionalProperties": false,
          "required": ["workspace", "tabRef", "tabUuid", "via"],
          "properties": {
            "workspace": { "$ref": "#/$defs/nullableString" },
            "tabRef": { "$ref": "#/$defs/nullableString" },
            "tabUuid": { "type": "string" },
            "via": { "enum": ["recorded", "cwd"] }
          }
        },
        "surfaceReason": { "$ref": "#/$defs/nullableString" },
        "answerable": { "type": "boolean" },
        "actions": {
          "type": "array",
          "description": "[{kind:'reply'}] when answerable, [] otherwise. There is no dismiss.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": { "kind": { "const": "reply" } }
          }
        }
      }
    },
    "jiraDriftItem": {
      "type": "object",
      "required": ["epic", "direction", "note"],
      "properties": {
        "epic": { "type": "string" },
        "direction": { "enum": ["jira-done-git-live", "jira-inprogress-git-quiet", "jira-inprogress-no-git"] },
        "note": { "type": "string" },
        "detectedAt": { "type": "string" }
      }
    },
    "attention": {
      "type": "object",
      "required": ["type", "actions"],
      "properties": {
        "type": { "enum": ["blocked", "rule-violation", "decision", "mergeable", "orphan", "orphan-group", "spec-orphan", "spec-orphan-group"] },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      },
      "oneOf": [
        { "properties": { "type": { "const": "blocked" } }, "required": ["type", "sessionKey", "deadline"] },
        { "properties": { "type": { "const": "rule-violation" } }, "required": ["type", "repo", "env", "note"] },
        { "properties": { "type": { "const": "decision" } }, "required": ["type", "id", "title", "since"] },
        { "properties": { "type": { "const": "mergeable" } }, "required": ["type", "epic", "note"] },
        { "properties": { "type": { "const": "orphan" } }, "required": ["type", "repo", "branch"] },
        { "properties": { "type": { "const": "spec-orphan" } }, "required": ["type", "specFolder"] },
        { "properties": { "type": { "const": "orphan-group" }, "count": { "type": "integer", "minimum": 2 }, "items": { "type": "array", "minItems": 2 } }, "required": ["type", "count", "items"] },
        { "properties": { "type": { "const": "spec-orphan-group" }, "count": { "type": "integer", "minimum": 2 }, "items": { "type": "array", "minItems": 2 } }, "required": ["type", "count", "items"] }
      ]
    }
  }
}
