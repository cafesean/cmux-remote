{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "inbox classifier verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "reason"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["needs-decision", "offer-more", "status-only"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
